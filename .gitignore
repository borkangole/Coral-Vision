# --- Training (Python) ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Dataset images stay out of Git (size + licensing); keep the folder layout
training/data/raw/**
!training/data/raw/**/
!training/data/raw/**/.gitkeep
training/data/processed/**
!training/data/processed/.gitkeep

# Trained models and exports are large; share them separately
training/models/**
!training/models/.gitkeep
training/export/**
!training/export/.gitkeep
*.keras
*.h5
